# ==============================================
# Y Exam Prep — Environment Variables
# ==============================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ─── Supabase ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Stripe (OPCIONAL mientras estés en modo demo) ──
#
# Podés dejarlas TODAS vacías y setear ENABLE_SIMULATED_CHECKOUT=true
# para que la app simule los pagos (flow /pago/simular). Cuando estés
# listo para cobrar de verdad, pegás las keys live y sacás la variable
# de simulación.
#
# STRIPE_SECRET_KEY=sk_live_xxx          # en simulación: dejá vacío
# STRIPE_WEBHOOK_SECRET=whsec_xxx        # solo cuando tengas webhook live
# STRIPE_PRICE_BASIC=price_xxx           # price ID LIVE del Plan Básico
# STRIPE_PRICE_PREMIUM=price_xxx         # price ID LIVE del Plan Premium
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# ─── Payments mode ─────────────────────────────
# Dejá en "true" mientras Stripe no esté configurado.
# Cuando tengas Stripe live + los 4 valores de arriba, sacá esta línea.
ENABLE_SIMULATED_CHECKOUT=true

# ─── AI (Fase 2, por ahora oculto del nav) ─────
AI_API_KEY=

# ─── App ───────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
